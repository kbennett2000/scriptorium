{
  "name": "@scriptorium/reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scriptorium reader client (Vite + React + TypeScript). Offline-first; owns books on-device after checkout.",
  "scripts": {
    "gen:types": "node ../shared/gen-types.mjs",
    "predev": "npm run gen:types",
    "prebuild": "npm run gen:types",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "minisearch": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9"
  }
}

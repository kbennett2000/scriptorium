# Copy to .env and fill in SECRET_KEY + DATABASE_PASSWORD (the real .env is gitignored).
# django-environ reads these; values are consumed by the upstream gutendex settings.py.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# LAN dev box: allow any Host header. Tighten to a hostname/IP list if you expose it wider.
ALLOWED_HOSTS=*

# --- Database (must match the db service in docker-compose.yml) ---
DATABASE_NAME=gutendex
DATABASE_USER=gutendex
DATABASE_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Paths inside the container (settings.py requires these to be set) ---
STATIC_ROOT=/app/static_root
MEDIA_ROOT=/app/media

# --- Error-reporting knobs settings.py reads; empty is fine for a private instance ---
ADMIN_NAMES=
ADMIN_EMAILS=
MANAGER_NAMES=
MANAGER_EMAILS=
EMAIL_HOST=
EMAIL_HOST_ADDRESS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Build pin (optional; docker-compose.yml has the same default) ---
GUTENDEX_REF=c3f75a8bd783ca91d9cd37d133028ff994e7ba4b

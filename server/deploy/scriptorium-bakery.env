# Environment for the scriptorium bakery service (port 8720).
# Read by scriptorium-bakery.service via EnvironmentFile=.
# systemd EnvironmentFile format: KEY=VALUE, one per line, no `export`, no quotes.
#
# SCRIPTORIUM_DATA is the ONLY irreplaceable data in the system (ADR-0007). If it
# is unset the app falls back to /var/lib/scriptorium and published books vanish
# from the library + writes 500 — always set it here.
SCRIPTORIUM_DATA=/home/kb/scriptorium-data

# GPU services on the LAN. The bakery reports `degraded` and any bake parks in
# waiting_gpu if these are unset or unreachable.
TTS_URL=http://localhost:8712
IMAGEGEN_URL=http://localhost:8189

# Read timeouts (seconds) for the lock-gated GPU-service calls. The two services share a
# server-side GPU-tenancy lock (ADR-0039), so a call can BLOCK behind another tenant's long
# render (a Wan video is ~20 min) instead of 503-ing. The defaults below are generous enough
# to wait that out rather than time out and re-queue waiting_gpu each tick. Uncomment to tune;
# the quick /health / unload probes are separate and always short (never lock-gated).
# TTS_TRANSFORM_TIMEOUT_S=1200
# IMAGEGEN_GENERATE_TIMEOUT_S=1200
# IMAGEGEN_ANIMATE_TIMEOUT_S=1200

# Self-hosted Gutendex (book search). Prefer the local instance (see
# server/deploy/gutendex/); the code falls back to public gutendex.com on error/no-match.
GUTENDEX_URL=http://localhost:8721
